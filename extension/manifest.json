{
  "manifest_version": 3,
  "name": "entDM",
  "version": "0.1.0",
  "description": "Send downloads to the entDM desktop app.",
  "permissions": ["downloads", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "entDM",
    "default_popup": "popup.html"
  }
}
